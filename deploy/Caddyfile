# Cassia all-in-one 部署：单域名同时服务前端与控制面。
#
# 用法：把 YOUR_DOMAIN 换成你的域名。Caddy 会自动申请 Let's Encrypt 证书。
# 需要同时保留 IP 直连（部署/排障备用通道）时，站点地址写成两个：
#   http://<IP>, YOUR_DOMAIN {
# IP 地址带 http:// 前缀则只走 80，域名自动 HTTPS，两者共用同一套路由。
#
# 路由约定（与前端 lib/authToken.ts 的 SOCKET_URL 配合）：
#   /socket.io/*  → socket-server :4000（事件流）
#   /sessions/*   → socket-server :4000（文件上传/下载）
#   其余          → Next.js :3000
# 前端构建时把 NEXT_PUBLIC_SOCKET_URL 设成 https://YOUR_DOMAIN 即可同域直连。

YOUR_DOMAIN {

	handle /socket.io/* {
		reverse_proxy 127.0.0.1:4000
	}

	handle /sessions/* {
		reverse_proxy 127.0.0.1:4000
	}

	# 部署 webhook(POST /deploy、/switch-template)。token 错误时 socket-server
	# 回 404,不暴露端点存在。不开 4000 端口也能从外网触发部署。
	handle /deploy {
		reverse_proxy 127.0.0.1:4000
	}

	handle /switch-template {
		reverse_proxy 127.0.0.1:4000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
