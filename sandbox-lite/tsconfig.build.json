{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "paths": { "@cassia/shared": ["./shared/src/index.ts"] }
  },
  "include": ["shared/src/**/*.ts", "agent-runtime/src/**/*.ts"]
}
