# ── 模型 ──────────────────────────────────────────────
# 本机跑 agent-runtime 时，pi 直接读 ~/.pi/agent/auth.json，这里可以不填。
# 跑 E2B 沙箱时必须填 —— key 在 WebSocket attach 时下发给沙箱内的 runtime，
# 不会烤进镜像，也不会进 E2B 的环境变量。
#
# 注意：pi 0.87 不会从 `deepseek/xxx` 这种 model 字符串反推 provider，
# 会错去 openrouter 找 key。所以 provider 必须显式给 PI_PROVIDER，
# PI_MODEL 用裸模型 ID（deepseek-chat / deepseek-reasoner）。
PI_MODEL=deepseek-flash
PI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# ── 运行位置 ──────────────────────────────────────────
# 设了就用本机的 runtime（开发用，秒级反馈）；不设则起 E2B 沙箱。
AGENT_RUNTIME_URL=http://localhost:8330

# ── E2B ───────────────────────────────────────────────
# E2B_API_KEY=
#
# 模板二选一，都要先自己构建（见 README「构建沙箱模板」）：
#   cassia-lite  只有终端。冷启动 ~3s，2 vCPU / 2GB。
#   cassia       终端 + 浏览器画面。冷启动 ~15s，2 vCPU / 4GB。
# 不设默认 cassia-lite。官方 base 模板**不能用** —— 它的 node 是 20.9，
# 低于 pi 要求的 22.19。
# E2B_TEMPLATE=cassia-lite
# E2B_TIMEOUT_MS=1800000

# 会话空闲多久进入休眠（毫秒）。休眠 = 沙箱被 E2B 暂停（全内存快照，不计费），
# 不是销毁 —— 下次活跃时原地唤醒，文件、进程、对话上下文都在。
# SANDBOX_IDLE_MS=900000

# ── Agent 工具扩展（可选）───────────────────────────────
# pi 工具集增量调整（逗号分隔，如 +codemode 叠加 codemode）。默认空 = pi 默认工具。
# PI_TOOLS_ADJUST=+codemode
#
# MCP 服务器（设计 docs/12-mcp-design.md）。provision 时原文写入沙箱
# ~/.pi/agent/mcp.json，格式与 Claude Code 等 MCP client 一致（mcpServers 包裹）。
# 只支持无认证/token 的 server（v1 不做 OAuth 跳转）。不配 = 完全不写文件。
# MCP_SERVERS='{"mcpServers":{"seqthink":{"command":"npx","args":["-y","mcp-sequentialthinking-tools"],"exposure":"direct"}}}'

# ── 端口与域名（all-in-one 单域名部署）──────────────────
SOCKET_PORT=4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# 生产：Caddy 把 /socket.io/* 与 /sessions/* 反代到 :4000，
# 其余到 :3000，所以这里直接填公网域名（构建时 baked 进前端）：
# NEXT_PUBLIC_SOCKET_URL=https://your-domain.com
# CORS_ORIGIN=https://your-domain.com
# 页脚/法律页/充值失败提示里的客服邮箱：
# NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com

# ── 登录（InsForge）────────────────────────────────────
# 两个都设了前端才显示登录门、socket-server 才强制鉴权；不设就是开放模式
# （本地开发、全部 e2e 脚本不受影响）。anon key 是前端安全密钥，从
# `npx @insforge/cli secrets get ANON_KEY` 取；service/api key 永远不进这里。
# NEXT_PUBLIC_INSFORGE_URL=https://<appkey>.<region>.insforge.app
# NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_...
# socket-server 侧内省校验用的后端地址（同上，不带 NEXT_PUBLIC）
# INSFORGE_URL=https://<appkey>.<region>.insforge.app

# ── 积分与支付（waffo）─────────────────────────────────
# 有 INSFORGE_URL 积分治理即启用（试用 100、耗尽硬停止、会话预算）。
# TRIAL_CREDITS=100
# CREDIT_MARKUP=2          # pi 成本 → 积分倍率（覆盖 E2B/带宽/通道费）
# SESSION_CREDIT_CAP=500   # 单会话累计消耗上限，到顶自动 abort
# CREDITS_DEBUG=1          # e2e 后门 debug_grant —— 生产绝不设
#
# waffo 凭证（server-only，永不进 NEXT_PUBLIC）。私钥单行存储（\n 转义）。
# 产品由 scripts/waffo-setup.mjs 一次性建好，productId 写回这里。
# WAFFO_MERCHANT_ID=MER_...
# WAFFO_STORE_ID=STO_...
# WAFFO_PRIVATE_KEY=-----BEGIN...（单行）
# WAFFO_PRODUCT_PACK_500=PROD_...
# WAFFO_PRODUCT_PACK_2000=PROD_...
# WAFFO_PRODUCT_PACK_5000=PROD_...
# APP_ORIGIN=http://localhost:3000   # 收银台支付成功后跳回的地址
#
# 沙箱存储对账（scripts/sandbox-storage-report.mjs）
# SANDBOX_MAX_AGE_DAYS=30  # paused 超过即清理
